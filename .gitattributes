* text=auto
*.R text eol=lf
*.Rmd text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.png binary
*.gz binary
*.md text eol=lf
*.json text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# Preserve exact bytes of data and hashed historical exports across checkouts.
data/** -text
provenance/** -text
reference/** -text

# CRLF is intentional in exact-byte historical data; still check other whitespace.
data/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
provenance/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reference/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
